# Copy this file to ".env" and fill in the values from
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Set to true only after enabling Google in Supabase → Authentication → Providers
VITE_ENABLE_GOOGLE=false

# Your live website address. Links in sign-up / password-reset emails will open here.
# Set this in Vercel → Settings → Environment Variables (and in .env before building the Android app).
VITE_SITE_URL=https://hisaab-khata-portal.vercel.app
